@model ClothingStore.Models.Product

@{
    ViewData["Title"] = "Детайли за продукта";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row">
        <!-- Снимка на продукта -->
        <div class="col-md-6">
            <img src="@Model.ImageUrl" class="img-fluid rounded shadow-sm" alt="@Model.Name" />
        </div>

        <!-- Информация за продукта -->
        <div class="col-md-6">
            <h2 class="mb-3">@Model.Name</h2>
            <p class="text-muted mb-2"><strong>Категория:</strong> @Model.Category?.Name</p>
            <p class="h4 text-primary mb-4">@Model.Price.ToString("C")</p>

            <p class="mb-4">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @Model.Description
                }
                else
                {
                    <span class="text-muted fst-italic">Няма описание за този продукт.</span>
                }
            </p>

            @if (!User.IsInRole("Admin"))
            {
                <form asp-controller="Cart" asp-action="Add" method="post">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <button type="submit" class="btn btn-lg btn-primary">Купи сега</button>
                </form>
            }

            <div class="mt-3">
                <a asp-controller="Products" asp-action="All" class="btn btn-outline-secondary">Назад към всички продукти</a>
            </div>
        </div>
    </div>
</div>
