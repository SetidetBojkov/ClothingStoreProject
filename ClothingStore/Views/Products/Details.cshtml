@model ClothingStore.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>@ViewData["Title"]</h1>

<div>
    <h2>@Model.Name</h2>
    <p><strong>Category:</strong> @Model.Category.Name</p>
    <p><strong>Description:</strong> @Model.Description</p>
    <p><strong>Price:</strong> @Model.Price.ToString("C")</p>
</div>

<a class="btn btn-secondary" href="@Url.Action("All", "Products")">Back to All Products</a>
