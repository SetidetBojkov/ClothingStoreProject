@model ClothingStore.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

<div class="card mb-4">
    <div class="row g-0">
        <div class="col-md-4">
            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded-start" />
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h2 class="card-title">@Model.Name</h2>
                <p class="card-text"><strong>Категория:</strong> @Model.Category?.Name</p>
                <p class="card-text"><strong>Описание:</strong> @Model.Description</p>
                <p class="card-text"><strong>Цена:</strong> @Model.Price.ToString("C")</p>

                @* Бутон Купи сега – само за не-админ *@
                @if (!User.IsInRole("Admin"))
                {
                    <form asp-controller="Cart" asp-action="Add" method="post" class="mt-3">
                        <input type="hidden" name="productId" value="@Model.Id" />
                        <button type="submit" class="btn btn-primary">Купи сега</button>
                    </form>
                }

                <a class="btn btn-outline-secondary mt-3 ms-2" href="@Url.Action("All", "Products")">⬅ Назад към всички продукти</a>
            </div>
        </div>
    </div>
</div>
