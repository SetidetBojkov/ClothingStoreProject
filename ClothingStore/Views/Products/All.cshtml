@model IEnumerable<ClothingStore.Models.Product>

@{
    ViewData["Title"] = "Products - All";
}

<h1 class="mb-4">@ViewData["Title"]</h1>

@if (User.IsInRole("Admin"))
{
    <a href="@Url.Action("Add", "Products")" class="btn btn-success mb-3">Add New Product</a>
}

@if (!Model.Any())
{
    <div class="alert alert-warning">No products available.</div>
}
else
{
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100">
                    <a href="@Url.Action("Details", "Products", new { id = product.Id })">
                        <img src="@product.ImageUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="Product Image" />
                    </a>
                    <div class="card-body">
                        <h5 class="card-title">
                            <a href="@Url.Action("Details", "Products", new { id = product.Id })" class="text-decoration-none text-dark">
                                @product.Name
                            </a>
                        </h5>
                        <p class="card-text text-muted">@product.Price.ToString("C")</p>
                        <p class="card-text"><small>@product.Category?.Name</small></p>
                        <a class="btn btn-outline-primary" href="@Url.Action("Details", "Products", new { id = product.Id })">Details</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
