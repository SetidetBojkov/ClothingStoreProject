@model IEnumerable<ClothingStore.Models.Order>
@using ClothingStore.Models

@{
    ViewData["Title"] = "All Orders";
    var statuses = ViewBag.Statuses as List<OrderStatus>;
}

<h1>@ViewData["Title"]</h1>

<form method="get" class="mb-3 row g-3">
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select class="form-select" name="status">
            <option value="">-- All --</option>
            @foreach (var status in statuses)
            {
                <option value="@status">@status</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label class="form-label">From Date</label>
        <input type="date" name="from" class="form-control" />
    </div>
    <div class="col-md-3">
        <label class="form-label">To Date</label>
        <input type="date" name="to" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Filter</button>
    </div>
</form>

@if (!Model.Any())
{
    <p>No orders found.</p>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <div>
                    <strong>Order #@order.Id</strong> |
                    <span>User: @order.User.UserName</span> |
                    <span>Date: @order.OrderDate.ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <form asp-action="ChangeStatus" asp-controller="Orders" method="post" class="d-flex">
                    <input type="hidden" name="orderId" value="@order.Id" />
                    <select name="status" class="form-select me-2">
                        @foreach (OrderStatus s in Enum.GetValues(typeof(OrderStatus)))
                        {
                            <option value="@s" selected="@(s == order.Status)">@s</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-primary">Change</button>
                </form>
            </div>
            <div class="card-body">
                <ul class="list-group">
                    @foreach (var item in order.Items)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            @item.Product.Name (x@item.Quantity)
                            <span>@(item.Product.Price * item.Quantity).ToString("C")</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    }
}
