@model List<ClothingStore.Models.CartItem>

@{
    ViewData["Title"] = "Количка";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var total = Model.Sum(item => item.Product.Price * item.Quantity);
}

<div class="container my-5">
    <h2 class="text-center mb-4">Моята количка</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center">
            Количката ви е празна.
            <br />
            <a href="/Products/All" class="btn btn-outline-primary mt-3">Разгледай продукти</a>
        </div>
    }
    else
    {
        <table class="table table-bordered align-middle shadow-sm">
            <thead class="table-light">
                <tr>
                    <th>Продукт</th>
                    <th class="text-center">Количество</th>
                    <th class="text-end">Цена</th>
                    <th class="text-end">Общо</th>
                    <th class="text-center">Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                <img src="@item.Product.ImageUrl" style="width: 80px; height: 80px; object-fit: cover;" class="rounded shadow-sm" />
                                <div>
                                    <strong>@item.Product.Name</strong><br />
                                    <small class="text-muted">@item.Product.Category?.Name</small>
                                </div>
                            </div>
                        </td>
                        <td class="text-center">@item.Quantity</td>
                        <td class="text-end">@item.Product.Price.ToString("C")</td>
                        <td class="text-end">@((item.Product.Price * item.Quantity).ToString("C"))</td>
                        <td class="text-center">
                            <form asp-controller="Cart" asp-action="Remove" method="post">
                                <input type="hidden" name="productId" value="@item.Product.Id" />
                                <button class="btn btn-sm btn-danger">Премахни</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="3" class="text-end"><strong>Обща сума:</strong></td>
                    <td class="text-end"><strong>@total.ToString("C")</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>

        <div class="text-end">
            <a href="/Checkout" class="btn btn-success btn-lg">Продължи към поръчка</a>
        </div>
    }
</div>
