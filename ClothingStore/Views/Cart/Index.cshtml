@model List<ClothingStore.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h1>@ViewData["Title"]</h1>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Product</th>
                <th>Quantity</th>
                <th>Price per item</th>
                <th>Total</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Product.Name</td>
                    <td>@item.Quantity</td>
                    <td>@item.Product.Price.ToString("C")</td>
                    <td>@(item.Product.Price * item.Quantity).ToString("C")</td>
                    <td>
                        <a class="btn btn-danger" href="@Url.Action("Remove", "Cart", new { productId = item.ProductId })">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Total Amount: @Model.Sum(x => x.Product.Price * x.Quantity).ToString("C")</h3>

    <form asp-controller="Orders" asp-action="Create" method="post">
        <button type="submit" class="btn btn-success">Place Order</button>
    </form>
}
