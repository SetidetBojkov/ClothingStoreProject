@model List<ClothingStore.Models.Order>

@{
    ViewData["Title"] = "Всички поръчки";
}

<h1 class="mb-4">📦 Всички поръчки</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">Няма направени поръчки.</div>
}
else
{
    @foreach (var order in Model)
    {
        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Поръчка #@order.Id</strong>
                <span>Потребител: @order.User?.Email | Дата: @order.OrderDate.ToString("g")</span>
            </div>
            <div class="card-body">
                <ul class="mb-3">
                    @foreach (var item in order.Items)
                    {
                        <li>@item.ProductName (@item.Quantity бр.) - @(item.Price * item.Quantity).ToString("C")</li>
                    }
                </ul>

                <div class="d-flex align-items-center gap-2">
                    <form asp-action="UpdateOrderStatus" asp-controller="Admin" method="post" class="d-flex align-items-center gap-2">
                        <input type="hidden" name="id" value="@order.Id" />
                        <select name="status" class="form-select">
                            @foreach (var status in Enum.GetValues(typeof(ClothingStore.Models.OrderStatus)))
                            {
                                <option value="@status" selected="@(order.Status.ToString() == status.ToString() ? "selected" : null)">@status</option>
                            }
                        </select>
                        <button type="submit" class="btn btn-outline-primary">Промени</button>
                    </form>

                    <form asp-action="DeleteOrder" asp-controller="Admin" method="post" class="d-inline" onsubmit="return confirm('Сигурни ли сте, че искате да изтриете тази поръчка?');">
                        <input type="hidden" name="id" value="@order.Id" />
                        <button type="submit" class="btn btn-outline-danger">Изтрий</button>
                    </form>
                </div>
            </div>
        </div>
    }
}